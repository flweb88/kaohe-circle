<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.kaohe.worker.plist — 考核小管家 Mac 压缩工人 launchd（已启用 2026-09-30）

  行为：每 StartInterval 秒跑一轮 kaohe-worker.sh（脚本自身做单轮，无活即静默退出）。
  安装步骤（已执行）：
    1. kaohe-worker.sh → ~/.local/bin/kaohe-worker.sh（chmod +x）
    2. 本文件 → ~/Library/LaunchAgents/com.kaohe.worker.plist
    3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.kaohe.worker.plist
  运维：
    卸载：launchctl bootout gui/$(id -u)/com.kaohe.worker
    立即触发一轮：launchctl kickstart gui/$(id -u)/com.kaohe.worker
    日志：~/.local/log/kaohe-worker.log（脚本自写）、kaohe-worker.{out,err}.log（launchd）
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kaohe.worker</string>

    <!-- 脚本路径：改成实际安装路径（当前用户 home 为 /Users/fangliang，按机替换） -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/fangliang/.local/bin/kaohe-worker.sh</string>
    </array>

    <!-- 每 45 秒一轮（方案要求 30~60s 区间） -->
    <key>StartInterval</key>
    <integer>45</integer>

    <!-- ffmpeg 不在默认 PATH（~/.local/bin），显式注入 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>KAOHE_FFMPEG</key>
        <string>/Users/fangliang/.local/bin/ffmpeg</string>
    </dict>

    <!-- 登录即跑一轮 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 日志：脚本自身写 ~/.local/log/kaohe-worker.log；
         launchd 的 stdout/stderr 单独留档，正常轮次为空 -->
    <key>StandardOutPath</key>
    <string>/Users/fangliang/.local/log/kaohe-worker.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/fangliang/.local/log/kaohe-worker.err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/fangliang/.cache/kaohe-worker</string>

    <!-- 不请求网络/无权/通知，保持最小权限 -->
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
